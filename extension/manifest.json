{
  "manifest_version": 3,
  "name": "Smart Form Filler",
  "version": "1.0.0",
  "description": "AI-powered form filling and data extraction browser extension",
  "permissions": ["activeTab", "storage", "scripting", "sidePanel", "tabs", "clipboardWrite"],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "http://localhost:*/*",
    "http://localhost:11434/*",
    "https://*.azurewebsites.net/*",
    "https://*.openai.azure.com/*",
    "https://*.ai.azure.com/*",
    "https://login.microsoftonline.com/*"
  ],
  "action": {
    "default_title": "Page Summarizer"
  },
  "side_panel": {
    "default_path": "dist/extension/popup_ts.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/modules/formDetector.js",
        "src/modules/formFiller.js",
        "content-iframe.js",
        "dist/content.js",
        "src/content-analyzer.js"
      ],
      "run_at": "document_end"
    }
  ],
  "background": {
    "service_worker": "dist/background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["src/auth/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
